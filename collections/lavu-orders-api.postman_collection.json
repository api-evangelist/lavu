                  "description": "(Required) API key from the API tab of the POSLavu Control Panel."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API token from the API tab of the POSLavu Control Panel."
                },
                {
                  "disabled": false,
                  "key": "table",
                  "value": "<string>",
                  "description": "(Required) The data table to query."
                },
                {
                  "disabled": false,
                  "key": "column",
                  "value": "<string>",
                  "description": "Column name to filter on."
                },
                {
                  "disabled": false,
                  "key": "value",
                  "value": "<string>",
                  "description": "Exact value to match for the filter column."
                },
                {
                  "disabled": false,
                  "key": "value_min",
                  "value": "<string>",
