                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "dataname",
                  "value": "<string>",
                  "description": "(Required) Account data name from the API tab of the POSLavu Control Panel."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key from the API tab of the POSLavu Control Panel."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API token from the API tab of the POSLavu Control Panel."
                },
                {
                  "disabled": false,
                  "key": "table",
                  "value": "<string>",
                  "description": "(Required) The data table to query."
                },
                {
                  "disabled": false,
                  "key": "column",
                  "value": "<string>",
                  "description": "Column name to filter on."
                },
                {
                  "disabled": false,
                  "key": "value",
                  "value": "<string>",
                  "description": "Exact value to match for the filter column."
                },
                {
