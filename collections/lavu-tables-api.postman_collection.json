  "info": {
    "_postman_id": "bfc48a62-279d-4402-b459-f93ebe104a53",
    "name": "Lavu (POSLavu) Inventory Tables API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "POST-based data API for the Lavu restaurant point-of-sale platform. A single request endpoint accepts form-encoded credentials (dataname, key, token) plus a `table` selector and returns XML `<row>` elements for the requested table. The documented tables expose menu structure (menu_groups, menu_categories, menu_items), floor layout (tables), and transactions (orders, order_contents, order_payments) along with inventory data (ingredients, ingredient_usage). Records can be written by adding `cmd=insert` and an XML `contents` payload. Documentation is published at admin.poslavu.com and credentials are retrieved from the API tab of the POSLavu Control Panel.\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
